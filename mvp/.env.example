# API
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bioshift
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Frontend only; leave blank for the local Vite proxy. Set to the deployed API origin in production.
VITE_API_URL=

# Payments stay in demo mode until Stripe Connect is configured.
PAYMENTS_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
